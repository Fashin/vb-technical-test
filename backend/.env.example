# Copy to `.env` and fill in. `.env` is gitignored; this file is not.

# VirtualBrain chatbot API key, from the chatbot's settings on
# app.getvirtualbrain.com. Looks like `vb_ak_...`.
# The backend exchanges it for short-lived tokens at startup; the key itself
# never leaves the server and is never sent to the browser.
VIRTUALBRAIN_API_KEY=

# Optional overrides.
# PORT=3001
# BOOSTER_INTERVAL_MS=600000
# EXPORT_DIR=./pokemons-ru
# DB_PATH=./data/app.db
